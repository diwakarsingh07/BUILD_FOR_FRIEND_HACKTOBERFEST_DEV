# ==========================================
# ALEX ENVIRONMENT CONFIGURATION TEMPLATE
# ==========================================
# Copy this file to .env and fill in your API credentials:
# cp .env.example .env

# Google AI Studio / Gemini API Key (https://aistudio.google.com/)
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Groq Cloud API Key (https://console.groq.com/)
GROQ_API_KEY=your_groq_api_key_here

# MongoDB Atlas Connection URI (https://cloud.mongodb.com/)
# Example: mongodb+srv://<username>:<password>@cluster.mongodb.net/?appName=Hackathon
MONGO_URI=your_mongodb_atlas_connection_uri_here

# SerpApi Key for Real-Time Search, Flights, Hotels, News (https://serpapi.com/)
SERPAPI_KEY=your_serpapi_key_here
